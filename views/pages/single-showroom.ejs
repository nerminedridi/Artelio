<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - <%= showroom.title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&family=Ibarra+Real+Nova:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/single-showroom.css">
</head>
<body>
<%
  function renderStars(avg) {
    const rounded = Math.round(avg * 2) / 2;
    let html = "";
    for (let i = 1; i <= 5; i++) {
      if (rounded >= i) html += '<i class="bi bi-star-fill"></i>';
      else if (rounded >= i - 0.5) html += '<i class="bi bi-star-half"></i>';
      else html += '<i class="bi bi-star"></i>';
    }
    return html;
  }
  function timeAgo(date) {
    const days = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);
    if (days < 1) return "today";
    if (days === 1) return "1 day ago";
    if (days < 7) return `${days} days ago`;
    const weeks = Math.floor(days / 7);
    if (weeks < 5) return weeks === 1 ? "1 week ago" : `${weeks} weeks ago`;
    const months = Math.floor(days / 30);
    return months <= 1 ? "1 month ago" : `${months} months ago`;
  }
  const createdLabel = new Date(showroom.created_at).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
%>

    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">ARTélio</a>
            <nav class="nav-links">
                <a href="/showrooms.html">Showrooms</a>
                <a href="/curators.html">Curators</a>
                <a href="/artists.html">Artists</a>
                <a href="/explore.html">Explore</a>
            </nav>
            <div class="header-icons">
                <button class="icon-btn nav-toggle" id="navToggle" title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <button class="icon-btn" title="Search" data-nav="/search">
                    <i class="bi bi-search"></i>
                </button>
                <button class="icon-btn" title="Cart" data-nav="/cart-out">
                    <i class="bi bi-bag-heart"></i>
                </button>
                <% if (currentUser) { %>
                <button class="icon-btn" title="Profile" data-nav="/dashboard"><i class="bi bi-person"></i></button>
                <% } else { %>
                <a href="/login" class="btn-join">Join Now</a>
                <% } %>
            </div>
        </div>
    </header>


    <div class="breadcrumb">
        <button class="back-btn" data-back>
            <i class="bi bi-chevron-left"></i> Back to Showrooms
        </button>
    </div>

    <main class="main-container">

        <section class="top-card">
            <div class="card-image">
                <img src="<%= showroom.cover_image_url %>" alt="<%= showroom.title %>">
                <div class="image-overlay"></div>
            </div>

            <div class="card-content">
                <div class="curator-badge">
                    <div class="curator-avatar"><i class="bi bi-person-circle"></i></div>
                    <div class="curator-info">
                        <span class="curator-label">Curated by</span>
                        <h2 class="curator-name"><%= showroom.curator_name %></h2>
                    </div>
                </div>

                <h1 class="showroom-title"><%= showroom.title %></h1>

                <p class="showroom-description">
                    <%= showroom.concept_essay %>
                </p>

                <div class="showroom-stats">
                    <div class="stat">
                        <span class="stat-icon"><i class="bi bi-images"></i></span>
                        <span class="stat-label">Artworks</span>
                        <span class="stat-value"><%= showroom.artwork_count %></span>
                    </div>
                    <div class="stat">
                        <span class="stat-icon"><i class="bi bi-star-fill"></i></span>
                        <span class="stat-label">Avg. Rating</span>
                        <span class="stat-value"><%= Number(showroom.avg_artwork_rating).toFixed(1) %></span>
                    </div>
                    <div class="stat">
                        <span class="stat-icon"><i class="bi bi-heart-fill"></i></span>
                        <span class="stat-label">Followers</span>
                        <span class="stat-value"><%= showroom.follower_count %></span>
                    </div>
                    <div class="stat">
                        <span class="stat-icon"><i class="bi bi-people"></i></span>
                        <span class="stat-label">Reviews</span>
                        <span class="stat-value"><%= showroom.rating_count %></span>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn btn-primary">
                        <i class="bi bi-heart"></i> Follow Showroom
                    </button>
                    <button class="btn btn-secondary">
                        <i class="bi bi-share"></i> Share
                    </button>
                    <% if (currentUser && currentUser.id !== showroom.curator_id) { %>
                    <button class="btn btn-secondary report-btn" data-report-type="showroom" data-report-id="<%= showroom.id %>" data-report-toggle="reportBox-showroom-<%= showroom.id %>">
                        <i class="bi bi-flag"></i> Report
                    </button>
                    <% } %>
                </div>
                <% if (currentUser && currentUser.id !== showroom.curator_id) { %>
                <div class="report-box hidden" id="reportBox-showroom-<%= showroom.id %>">
                    <textarea class="report-reason" placeholder="Describe the issue with this showroom..."></textarea>
                    <button class="report-submit" data-report-type="showroom" data-report-id="<%= showroom.id %>">Submit Report</button>
                    <span class="report-status"></span>
                </div>
                <% } %>
            </div>
        </section>
        <section class="details-card">
            <h3 class="card-heading">About This Showroom</h3>

            <div class="details-grid">
                <div class="detail-row">
                    <span class="detail-label">Curator</span>
                    <span class="detail-value"><%= showroom.curator_name %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span class="detail-value"><span class="badge badge-active"><%= showroom.status === "active" ? "Active" : "Archived" %></span></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Specialty</span>
                    <span class="detail-value"><%= showroom.theme || "—" %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Created</span>
                    <span class="detail-value"><%= createdLabel %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Location</span>
                    <span class="detail-value">Online</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Theme Tags</span>
                    <span class="detail-value">
                        <% (showroom.mood_tags || []).forEach(function(tag) { %>
                        <span class="tag"><%= tag[0].toUpperCase() + tag.slice(1) %></span>
                        <% }); %>
                    </span>
                </div>
            </div>
        </section>

        <section class="artworks-section">
            <h3 class="section-heading">Featured Artworks</h3>

            <div class="artworks-grid">
                <% if (artworks.length === 0) { %>
                <p class="no-artworks">No approved artworks in this showroom yet.</p>
                <% } %>
                <% artworks.forEach(function(artwork) { %>
                <div class="artwork-card">
                    <div class="artwork-image">
                        <img src="<%= artwork.image_url %>" alt="<%= artwork.title %>" loading="lazy">
                        <div class="image-overlay"></div>
                        <button class="wishlist-btn"><i class="bi bi-heart"></i></button>
                    </div>
                    <div class="artwork-info">
                        <h4 class="artwork-title"><%= artwork.title %></h4>
                        <p class="artwork-artist">by <%= artwork.artist_name %></p>
                        <div class="artwork-rating">
                            <%- renderStars(artwork.avg_rating) %>
                            <span><%= Number(artwork.avg_rating).toFixed(1) %> (<%= artwork.rating_count %>)</span>
                        </div>
                        <div class="artwork-footer">
                            <span class="price">€<%= Number(artwork.price).toFixed(2) %></span>
                            <a href="/artwork-details?id=<%= artwork.id %>" class="view-btn">View →</a>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>
        <section class="feedback-section">
            <h3 class="section-heading">Community Feedback</h3>

            <div class="rating-box">
                <div class="rating-stars">
                    <%- renderStars(showroom.avg_artwork_rating) %>
                </div>
                <span class="rating-value"><%= Number(showroom.avg_artwork_rating).toFixed(1) %> out of 5</span>
                <span class="rating-count">Based on <%= showroom.rating_count %> review<%= showroom.rating_count == 1 ? "" : "s" %></span>
            </div>

            <% if (currentUser) { %>
            <div class="feedback-input">
                <textarea id="guestbookMessage" placeholder="Share your thoughts about this showroom..." rows="3"></textarea>
                <button class="submit-btn" id="submitGuestbookBtn" data-room-id="<%= showroom.id %>">Submit Review</button>
                <p class="form-error" id="guestbookError"></p>
            </div>
            <% } else { %>
            <p class="no-comments">Log in to leave a message in the guestbook.</p>
            <% } %>

            <div class="comments-list">
                <% if (guestbook.length === 0) { %>
                <p class="no-comments">No guestbook messages yet — be the first to sign in.</p>
                <% } %>
                <% guestbook.forEach(function(entry) { %>
                <div class="comment">
                    <div class="comment-avatar"><i class="bi bi-person-circle"></i></div>
                    <div class="comment-body">
                        <div class="comment-header">
                            <h4 class="comment-author"><%= entry.username %></h4>
                            <span class="comment-date"><%= timeAgo(entry.created_at) %></span>
                        </div>
                        <p class="comment-text">
                            <%= entry.message %>
                        </p>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>

    </div>

    </main>
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section footer-logo">
                <div class="logo-footer">
                    <span class="art">ART</span><span class="elio">élio</span>
                </div>
                <p class="footer-description">Human-curated art, made to be experienced. Discover masterpieces that speak to your soul.</p>
            </div>

            <div class="footer-section">
                <h4><a href="/about.html">About Us</a></h4>
                <ul>
                    <li><a href="/about.html#story">Our Story</a></li>
                    <li><a href="/about.html#mission">Our Mission</a></li>
                    <li><a href="/about.html#vision">Our Vision</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h4><a href="/help.html">Help</a></h4>
                <ul>
                    <li><a href="/help.html#faq">FAQ</a></li>
                    <li><a href="/help.html#privacy">Privacy Policy</a></li>
                    <li><a href="/help.html#terms">Terms and Conditions</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Get in Touch With Us</h4>
                <div class="newsletter-form">
                    <input type="email" placeholder="Enter your email address" class="email-input">
                    <button class="subscribe-btn">Subscribe</button>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 ARTélio. All rights reserved.</p>
        </div>
    </footer>
    <script>
      (function () {
        const submitGuestbookBtn = document.getElementById('submitGuestbookBtn');
        if (submitGuestbookBtn) {
            submitGuestbookBtn.addEventListener('click', async () => {
                const message = document.getElementById('guestbookMessage').value.trim();
                const err = document.getElementById('guestbookError');
                if (!message) {
                    err.textContent = 'Write a message first.';
                    err.classList.add('visible');
                    return;
                }
                const res = await fetch('/showroom/' + submitGuestbookBtn.dataset.roomId + '/guestbook', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message }),
                });
                if (res.ok) {
                    window.location.reload();
                } else {
                    err.textContent = 'Something went wrong. Try again.';
                    err.classList.add('visible');
                }
            });
        }

        document.querySelectorAll('.report-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                document.getElementById(btn.dataset.reportToggle).classList.toggle('hidden');
            });
        });
        document.querySelectorAll('.report-submit').forEach((btn) => {
            btn.addEventListener('click', async () => {
                const box = btn.closest('.report-box');
                const reason = box.querySelector('.report-reason').value.trim();
                const statusEl = box.querySelector('.report-status');
                if (!reason) {
                    statusEl.textContent = 'Please describe the issue.';
                    return;
                }
                const res = await fetch('/report', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ itemType: btn.dataset.reportType, itemId: btn.dataset.reportId, reason }),
                });
                const data = await res.json();
                statusEl.textContent = res.ok ? 'Report submitted. Thank you.' : data.error;
                if (res.ok) {
                    box.querySelector('.report-reason').disabled = true;
                    btn.disabled = true;
                    btn.textContent = 'Reported';
                }
            });
        });
      })();
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
