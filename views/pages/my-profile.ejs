<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - My Profile</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/my-profile.css">
</head>
<body>
    <header class="header">
        <h1 class="logo" data-nav="/dashboard">ARTélio</h1>
        <button class="close-btn" data-back>
            <i class="bi bi-x-lg"></i> Close
        </button>
    </header>

    <main class="profile-wrapper">
        <div class="profile-card">
            <div class="profile-avatar">
                <i class="bi bi-person-circle"></i>
            </div>
            <h1 class="profile-username"><%= profileUser.username %></h1>
            <span class="profile-role-badge role-<%= profileUser.role %>"><%= profileUser.role %></span>

            <div class="profile-details">
                <div class="profile-detail-row">
                    <span class="detail-label">Bio</span>
                    <span class="detail-value"><%= profileUser.bio || "No bio added yet." %></span>
                </div>
                <div class="profile-detail-row">
                    <span class="detail-label">Member since</span>
                    <span class="detail-value"><%= new Date(profileUser.created_at).toLocaleDateString("en-US", { month: "long", year: "numeric" }) %></span>
                </div>
            </div>

            <a href="/settings.html" class="edit-profile-btn">Edit in Settings</a>
        </div>
    </main>

    <footer class="footer">
        <p>© 2026 ARTélio. All rights reserved.</p>
    </footer>
    <script src="/js/main.js"></script>
</body>
</html>
