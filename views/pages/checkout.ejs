<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ARTélio — Checkout</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/checkout.css" />
</head>
<body>

  <header class="site-header">
    <a href="/" class="logo">ARTélio</a>
    <a href="/cart-in" class="close-btn">
      <span>× Close</span>
      <svg class="cart-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
    </a>
  </header>

  <div class="page-title-wrap">
    <h1 class="page-title"><em>Checkout</em></h1>
  </div>

  <main class="main-content">
    <form class="checkout-layout" method="POST" action="/checkout">
      <section class="form-card">
        <% if (error) { %>
        <p class="form-error visible"><%= error %></p>
        <% } %>
        <div class="step">
          <div class="step-header">
            <div class="step-badge">1</div>
            <h2 class="step-title">Personal details:</h2>
          </div>
          <div class="step-body">
            <div class="form-row two-col">
              <div class="form-group">
                <label>First Name</label>
                <input type="text" class="field" name="firstName" />
              </div>
              <div class="form-group">
                <label>Last Name</label>
                <input type="text" class="field" name="lastName" />
              </div>
            </div>
            <div class="form-row two-col">
              <div class="form-group">
                <label>Phone Number</label>
                <div class="phone-field field">
                  <span class="flag">🇮🇹</span>
                  <span class="dial-code">+39</span>
                  <input type="tel" class="phone-input" name="phone" />
                </div>
              </div>
              <div class="form-group">
                <label>Email Address</label>
                <input type="email" class="field" name="email" />
              </div>
            </div>
          </div>
        </div>

        <div class="step-divider"></div>

        <div class="step">
          <div class="step-header">
            <div class="step-badge">2</div>
            <h2 class="step-title">Delivery details:</h2>
          </div>
          <div class="step-body">
            <div class="form-row two-col">
              <div class="form-group">
                <label>Delivery Date</label>
                <input type="date" class="field" name="deliveryDate" />
              </div>
              <div class="form-group">
                <label>Convenient Time</label>
                <input type="time" class="field" name="deliveryTime" />
              </div>
            </div>
            <div class="form-row three-col">
              <div class="form-group">
                <label>City</label>
                <input type="text" class="field" name="city" />
              </div>
              <div class="form-group">
                <label>Zip Code</label>
                <input type="text" class="field" name="zipCode" />
              </div>
              <div class="form-group">
                <label>Address</label>
                <input type="text" class="field" name="address" />
              </div>
            </div>
          </div>
        </div>

        <div class="step-divider"></div>

        <div class="step">
          <div class="step-header">
            <div class="step-badge">3</div>
            <h2 class="step-title">Payment details:</h2>
          </div>
          <div class="step-body">
            <div class="form-group">
              <label>Card Number</label>
              <div class="card-details-row">
                <div class="card-number-field field">
                  <div class="visa-badge">CARD</div>
                  <input type="text" name="cardNumber" class="card-input" placeholder="16 digit card number" inputmode="numeric" maxlength="19" required>
                </div>
                <div class="form-group ccv-group">
                  <label>CVV</label>
                  <div class="field ccv-field">
                    <input type="text" name="cvv" class="ccv-input" placeholder="000" inputmode="numeric" maxlength="3" required>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-row two-col-narrow">
              <div class="form-group">
                <label>Validity Date</label>
                <div class="field validity-field">
                  <input type="text" name="expiry" class="validity-input" placeholder="MM/YY" maxlength="5" required>
                </div>
              </div>
              <div class="form-group">
                <label>Name of Card Holder</label>
                <input type="text" class="field" name="cardholderName" placeholder="">
              </div>
            </div>
          </div>
        </div>

        <div class="step-divider"></div>
        <div class="step">
          <div class="step-header">
            <div class="step-badge">4</div>
            <h2 class="step-title">Confirmation:</h2>
          </div>
          <div class="step-body confirm-body">
            <button type="submit" class="confirm-btn">Confirm Checkout &amp; Payment</button>
          </div>
        </div>

      </section>

      <aside class="summary-panel">
        <h2 class="summary-title">Summary</h2>
        <hr class="summary-divider"/>

        <% items.forEach(function(item) { %>
        <div class="summary-row">
          <span class="summary-label"><%= item.title %></span>
          <span class="summary-value">€<%= Number(item.price).toFixed(2) %></span>
        </div>
        <hr class="summary-divider"/>
        <% }); %>

        <div class="summary-row total-row">
          <span class="summary-label">Total</span>
          <span class="summary-value total-value">€<%= subtotal.toFixed(2) %></span>
        </div>
      </aside>

    </form>
  </main>
  <footer class="site-footer">
    <p>© 2026 ARTélio. All rights reserved.</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
