<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&family=Ibarra+Real+Nova:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard-admin.css">
</head>
<body>
<%
  function timeAgo(date) {
    const days = Math.floor((Date.now() - new Date(date).getTime()) / 86400000);
    if (days < 1) return "today";
    if (days === 1) return "1 day ago";
    if (days < 7) return `${days} days ago`;
    const weeks = Math.floor(days / 7);
    if (weeks < 5) return weeks === 1 ? "1 week ago" : `${weeks} weeks ago`;
    const months = Math.floor(days / 30);
    return months <= 1 ? "1 month ago" : `${months} months ago`;
  }
%>
    <header class="header">
        <h1 class="logo" data-nav="/home">ARTélio</h1>
        <div class="header-icons">
            <div class="notification-wrapper">
                <button class="icon-btn" id="notificationBell" title="Notifications"><i class="bi bi-bell"></i></button>
                <div class="notification-panel" id="notificationPanel">
                    <div class="notification-panel-header">
                        <h3>Notifications</h3>
                        <button class="mute-all-btn" id="muteAllBtn">Silence All</button>
                    </div>
                    <div class="notification-list" id="notificationList">
                        <div class="notification-item">
                            <p><%= pendingCurators %> curator<%= pendingCurators === 1 ? "" : "s" %> awaiting approval.</p>
                            <span class="notification-time">Today</span>
                        </div>
                        <div class="notification-item">
                            <p>Platform activity is up compared to last month.</p>
                            <span class="notification-time">This week</span>
                        </div>
                    </div>
                    <p class="notification-empty" id="notificationEmpty" hidden>Notifications silenced.</p>
                    <a href="/notifications" class="view-all-link">View All</a>
                </div>
            </div>
            <button class="icon-btn"><i class="bi bi-search"></i></button>
            <button class="icon-btn" title="Profile" data-nav="/my-profile"><i class="bi bi-person"></i></button>
        </div>
    </header>
    <div class="dashboard-wrapper">
        <aside class="sidebar">
            <nav class="sidebar-nav">
                <a href="/dashboard-admin/dashboard" class="nav-link <%= activeSection === "dashboard" ? "active" : "" %>" data-section="dashboard">Dashboard</a>
                <a href="/dashboard-admin/users" class="nav-link <%= activeSection === "users" ? "active" : "" %>" data-section="users">Users</a>
                <a href="/dashboard-admin/artworks" class="nav-link <%= activeSection === "artworks" ? "active" : "" %>" data-section="artworks">Artworks</a>
                <a href="/dashboard-admin/showrooms" class="nav-link <%= activeSection === "showrooms" ? "active" : "" %>" data-section="showrooms">Showrooms</a>
                <a href="/dashboard-admin/reports" class="nav-link <%= activeSection === "reports" ? "active" : "" %>" data-section="reports">Reports <% if (pendingReportCount > 0) { %>(<%= pendingReportCount %>)<% } %></a>
                <a href="/dashboard-admin/analytics" class="nav-link <%= activeSection === "analytics" ? "active" : "" %>" data-section="analytics">Analytics</a>
                <a href="/dashboard-admin/settings" class="nav-link <%= activeSection === "settings" ? "active" : "" %>" data-section="settings">Settings</a>
                <a href="/logout" class="nav-link">Logout</a>
            </nav>
        </aside>
        <main class="main-content">
            <section class="section <%= activeSection === "dashboard" ? "active" : "" %>" id="section-dashboard">
                <h2 class="section-heading">Dashboard:</h2>

                <div class="stat-grid">
                    <div class="stat-box">
                        <span class="stat-label">Users</span>
                        <span class="stat-number"><%= userCount %></span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-label">Artworks</span>
                        <span class="stat-number"><%= artworkCount %></span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-label">Showrooms</span>
                        <span class="stat-number"><%= showroomCount %></span>
                    </div>
                    <div class="stat-box stat-box-dark">
                        <span class="stat-label">Curators Awaiting Approval</span>
                        <span class="stat-number"><%= pendingCurators %></span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-label">Total Sales</span>
                        <span class="stat-number">€<%= platformTotals.totalSales.toFixed(2) %></span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-label">Total Commissions</span>
                        <span class="stat-number">€<%= platformTotals.totalCommissions.toFixed(2) %></span>
                    </div>
                </div>
                <div class="charts-row">
                    <div class="chart-box">
                        <canvas id="lineChart"></canvas>
                        <p class="chart-label">User signups per month</p>
                    </div>
                    <div class="chart-box">
                        <canvas id="pieChart"></canvas>
                        <p class="chart-label">Artwork tags distribution</p>
                    </div>
                </div>
                <div class="activity-box">
                    <h3 class="activity-title">Activity insights:</h3>
                    <ul class="activity-list">
                        <% recentActivity.forEach(function(a) { %>
                        <li>- <%= a.label %>: "<%= a.detail %>" · <%= timeAgo(a.at) %></li>
                        <% }); %>
                    </ul>
                </div>
            </section>
            <section class="section <%= activeSection === "users" ? "active" : "" %>" id="section-users">
                <h2 class="section-heading">Users Management:</h2>

                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Username</th>
                                <th>Mail</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(function(u) { %>
                            <tr>
                                <td><%= u.username %></td>
                                <td><%= u.email %></td>
                                <td><%= u.role %></td>
                                <td><span class="badge <%= u.status === 'suspended' ? 'badge-banned' : (u.status === 'pending' ? 'badge-pending' : 'badge-active') %>"><%= u.status %></span></td>
                                <td class="actions-cell">
                                    <% if (u.id === currentUser.id) { %>
                                    <span class="muted">(You)</span>
                                    <% } else { %>
                                    <% if (u.status === "pending") { %>
                                    <form method="POST" action="/admin/users/<%= u.id %>/status" class="inline-form">
                                        <input type="hidden" name="status" value="approved">
                                        <button type="submit" class="link-btn">Approve</button>
                                    </form>
                                    <% } %>
                                    <% if (u.status !== "suspended") { %>
                                    <form method="POST" action="/admin/users/<%= u.id %>/status" class="inline-form">
                                        <input type="hidden" name="status" value="suspended">
                                        <button type="submit" class="link-btn">Ban</button>
                                    </form>
                                    <% } else { %>
                                    <form method="POST" action="/admin/users/<%= u.id %>/status" class="inline-form">
                                        <input type="hidden" name="status" value="approved">
                                        <button type="submit" class="link-btn">Unban</button>
                                    </form>
                                    <% } %>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="section <%= activeSection === "artworks" ? "active" : "" %>" id="section-artworks">
                <h2 class="section-heading">Artworks Management:</h2>

                <div class="cards-grid">
                    <% artworks.forEach(function(a) { %>
                    <div class="admin-card">
                        <p><strong>Title:</strong> <%= a.title %></p>
                        <p><strong>Artist:</strong> <%= a.artist_name %></p>
                        <p><strong>Status:</strong> <%= a.status %></p>
                        <div class="card-actions">
                            <a href="/artwork-details?id=<%= a.id %>">View</a>
                            <form method="POST" action="/admin/artworks/<%= a.id %>/delete" class="inline-form" data-confirm="Delete this artwork?">
                                <button type="submit" class="danger link-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </section>
            <section class="section <%= activeSection === "showrooms" ? "active" : "" %>" id="section-showrooms">
                <h2 class="section-heading">Showrooms Management:</h2>

                <div class="cards-grid">
                    <% showrooms.forEach(function(s) { %>
                    <div class="admin-card">
                        <p><strong>Title:</strong> <%= s.title %></p>
                        <p><strong>Curator:</strong> <%= s.curator_name %></p>
                        <p><strong>Artworks:</strong> <%= s.artwork_count %></p>
                        <p><strong>Theme:</strong> <%= s.theme || "(none)" %></p>
                        <form method="POST" action="/admin/showrooms/<%= s.id %>/theme" class="inline-form theme-override-form">
                            <label class="sr-only" for="theme-<%= s.id %>">Override theme for <%= s.title %></label>
                            <input type="text" id="theme-<%= s.id %>" name="theme" value="<%= s.theme || "" %>" placeholder="Unique theme" required>
                            <button type="submit" class="link-btn">Save Theme</button>
                        </form>
                        <div class="card-actions">
                            <a href="/single-showroom?room=<%= s.id %>">View</a>
                            <form method="POST" action="/admin/showrooms/<%= s.id %>/delete" class="inline-form" data-confirm="Delete this showroom?">
                                <button type="submit" class="danger link-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </section>
            <section class="section <%= activeSection === "reports" ? "active" : "" %>" id="section-reports">
                <h2 class="section-heading">Reports & Moderation:</h2>

                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Item</th>
                                <th>Reported By</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (reports.length === 0) { %>
                            <tr><td colspan="7">No reports filed yet.</td></tr>
                            <% } %>
                            <% reports.forEach(function(r) { %>
                            <tr>
                                <td><%= r.item_type %></td>
                                <td>
                                    <% if (!r.item_exists) { %>
                                    <em>[deleted]</em>
                                    <% } else if (r.item_type === "artwork") { %>
                                    <a href="/artwork-details?id=<%= r.artwork_link_id %>" target="_blank"><%= r.item_label %></a>
                                    <% } else if (r.item_type === "showroom") { %>
                                    <a href="/single-showroom?room=<%= r.showroom_link_id %>" target="_blank"><%= r.item_label %></a>
                                    <% } else { %>
                                    <a href="/artwork-details?id=<%= r.artwork_link_id %>" target="_blank">"<%= r.item_label.length > 60 ? r.item_label.slice(0, 60) + "…" : r.item_label %>"</a>
                                    <% } %>
                                </td>
                                <td><%= r.reporter_name %></td>
                                <td><%= r.reason %></td>
                                <td><span class="badge <%= r.status === "pending" ? "badge-pending" : (r.status === "resolved" ? "badge-done" : "badge-dismissed") %>"><%= r.status %></span></td>
                                <td><%= new Date(r.created_at).toLocaleDateString() %></td>
                                <td class="actions-cell">
                                    <% if (r.status === "pending") { %>
                                    <form method="POST" action="/admin/reports/<%= r.id %>/resolve" class="inline-form">
                                        <button type="submit" class="link-btn">Resolve</button>
                                    </form>
                                    <form method="POST" action="/admin/reports/<%= r.id %>/dismiss" class="inline-form">
                                        <button type="submit" class="link-btn">Dismiss</button>
                                    </form>
                                    <% } else { %>
                                    <span class="resolved-note">by <%= r.resolved_by_name || "—" %></span>
                                    <% } %>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="section <%= activeSection === "analytics" ? "active" : "" %>" id="section-analytics">
                <h2 class="section-heading">Analytics:</h2>

                <div class="analytics-top">
                    <div class="analytics-list-box">
                        <h4>Top Artists</h4>
                        <ul>
                            <% topArtists.forEach(function(a) { %>
                            <li>· <%= a.username %> (<%= a.artwork_count %> artworks)</li>
                            <% }); %>
                        </ul>
                    </div>
                    <div class="analytics-list-box">
                        <h4>Top Showrooms</h4>
                        <ul>
                            <% topShowrooms.forEach(function(s) { %>
                            <li>· <%= s.title %> (<%= s.artwork_count %> artworks)</li>
                            <% }); %>
                        </ul>
                    </div>
                </div>

                <p class="analytics-subtitle">Live engagement total stats on our platform</p>

                <div class="analytics-stats">
                    <div class="analytics-stat">
                        <span class="a-stat-number"><%= userCount %></span>
                        <span class="a-stat-label">Users</span>
                    </div>
                    <div class="divider-v"></div>
                    <div class="analytics-stat">
                        <span class="a-stat-number"><%= artworkCount %></span>
                        <span class="a-stat-label">Artworks</span>
                    </div>
                    <div class="divider-v"></div>
                    <div class="analytics-stat">
                        <span class="a-stat-number"><%= showroomCount %></span>
                        <span class="a-stat-label">Showrooms</span>
                    </div>
                    <div class="divider-v"></div>
                    <div class="analytics-stat">
                        <span class="a-stat-number">€<%= platformTotals.totalSales.toFixed(2) %></span>
                        <span class="a-stat-label">Total Sales</span>
                    </div>
                    <div class="divider-v"></div>
                    <div class="analytics-stat">
                        <span class="a-stat-number">€<%= platformTotals.totalCommissions.toFixed(2) %></span>
                        <span class="a-stat-label">Total Commissions</span>
                    </div>
                </div>

                <h3 class="subsection-title">Commission Flow</h3>
                <p class="section-subtitle">Recent commission payments between artists and curators</p>
                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Artwork</th>
                                <th>Artist</th>
                                <th>Curator</th>
                                <th>Showroom</th>
                                <th>Sale Price</th>
                                <th>Commission</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (commissionFlow.length === 0) { %>
                            <tr><td colspan="7">No transactions yet.</td></tr>
                            <% } %>
                            <% commissionFlow.forEach(function(o) { %>
                            <tr>
                                <td><%= o.artwork_title %></td>
                                <td><%= o.artist_name %></td>
                                <td><%= o.curator_name || "—" %></td>
                                <td><%= o.room_title || "—" %></td>
                                <td>€<%= Number(o.gross_price).toFixed(2) %></td>
                                <td>€<%= Number(o.commission_amount).toFixed(2) %> (<%= Number(o.commission_rate).toFixed(2) %>%)</td>
                                <td><%= new Date(o.purchased_at).toLocaleDateString() %></td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="section <%= activeSection === "settings" ? "active" : "" %>" id="section-settings">
                <h2 class="section-heading">Settings:</h2>
                <div class="settings-card">
                    <div class="settings-row">
                        <span class="settings-label">Username</span>
                        <span class="settings-value"><%= currentUser.username %></span>
                    </div>
                    <div class="settings-row">
                        <span class="settings-label">Email</span>
                        <span class="settings-value"><%= currentUser.email %></span>
                    </div>
                    <form method="POST" action="/account/update-bio" class="settings-bio-form">
                        <label class="settings-label" for="bio">Bio</label>
                        <textarea id="bio" name="bio" class="settings-textarea" rows="3" placeholder="Add a short bio..."><%= currentUser.bio || "" %></textarea>
                        <button type="submit" class="action-btn"><i class="bi bi-check2"></i> Save</button>
                    </form>
                </div>
            </section>

        </main>
    </div>

    <footer class="footer">
        <p>© 2026 ARTélio. All rights reserved.</p>
    </footer>
    <script src="/js/vendor/page.js"></script>
    <script src="/js/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function showSection(id) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
            document.getElementById('section-' + id)?.classList.add('active');
            document.querySelector('[data-section="' + id + '"]')?.classList.add('active');
        }

        page('/dashboard-admin/:section', (ctx) => showSection(ctx.params.section));
        page('/dashboard-admin', () => showSection('dashboard'));
        page();

        const lineCtx = document.getElementById('lineChart').getContext('2d');
        new Chart(lineCtx, {
            type: 'line',
            data: {
                labels: <%- JSON.stringify(signups.map(s => s.month)) %>,
                datasets: [{
                    data: <%- JSON.stringify(signups.map(s => Number(s.count))) %>,
                    borderColor: '#2E3A5F',
                    backgroundColor: 'rgba(46,58,95,0.08)',
                    borderWidth: 2,
                    pointRadius: 3,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { grid: { color: '#eee' } }
                }
            }
        });
        const pieCtx = document.getElementById('pieChart').getContext('2d');
        new Chart(pieCtx, {
            type: 'pie',
            data: {
                labels: <%- JSON.stringify(categories.map(c => c.tag)) %>,
                datasets: [{
                    data: <%- JSON.stringify(categories.map(c => c.count)) %>,
                    backgroundColor: ['#2E3A5F', '#A15028', '#6F7DAE', '#D4AF37', '#8B96B8'],
                    borderWidth: 1
                }]
            },
            options: {
                plugins: { legend: { position: 'right', labels: { font: { size: 10 } } } }
            }
        });
    </script>
</body>
</html>
