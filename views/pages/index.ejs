<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Human-Curated Art</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700;800&family=Gelasio:wght@400;500;600;700&family=Luxurious+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/landing.css">
</head>
<body>


    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">ARTélio</a>
            <nav class="nav-links">
                <a href="/showrooms.html">Showrooms</a>
                <a href="/curators.html">Curators</a>
                <a href="/artists.html">Artists</a>
                <a href="/explore.html">Explore</a>
            </nav>
            <div class="header-icons">
                <button class="icon-btn nav-toggle" id="navToggle" title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <button class="icon-btn" title="Search" data-nav="/search">
                    <i class="bi bi-search"></i>
                </button>
                <button class="icon-btn" title="Cart" data-nav="/cart-out">
                    <i class="bi bi-bag-heart"></i>
                </button>
                <% if (typeof currentUser !== "undefined" && currentUser) { %>
                <button class="icon-btn" title="Profile" data-nav="/dashboard"><i class="bi bi-person"></i></button>
                <% } else { %>
                <a href="/login" class="btn-join">Join Now</a>
                <% } %>
            </div>
        </div>
    </header>

    <main class="page-background-wrapper">

      <section class="hero">
          <div class="hero-container">
              <div class="hero-left">
                  <div class="hero-title-block">
                      <span class="hero-welcome">WELCOME</span>
                      <span class="hero-title-line2">
                          <span class="hero-to">TO</span>
                          <span class="hero-art">ART</span>
                          <span class="hero-elio">élio</span>
                      </span>
                  </div>
                  <p class="hero-subtitle">Human-curated art, made to be experienced.</p>
              </div>
              <div class="hero-right">
                  <img src="/images/hero-bg.png" alt="Showroom" class="hero-image">
              </div>
          </div>
      </section>

      <div class="hero-dive-arrow">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 5V19" stroke="#573E2E" stroke-width="2" stroke-linecap="round"/>
              <path d="M6 13L12 19L18 13" stroke="#573E2E" stroke-width="2" stroke-linecap="round"/>
          </svg>
      </div>


      <section class="dive-within">
          <div class="dive-inner">
              <h2> Dive Within </h2>
              <div class="search-form">
                  <div class="search-bar">
                      <input class="search-input" type="text" placeholder="Search for art, artist, or curator...">
                  </div>
                  <button class="search-btn">Search</button>
              </div>
          </div>
      </section>

    <section class="popular-artwork">
        <h2 class="section-title">Popular Artworks</h2>

        <div class="carousel-wrapper">
            <div class="carousel-container">
                <div class="carousel" id="carousel">
                    <% artworks.forEach(function(artwork) { %>
                    <div class="carousel-item" data-artwork-id="<%= artwork.id %>">
                        <img src="<%= artwork.image_url %>" alt="<%= artwork.title %>" class="carousel-img">
                        <div class="carousel-overlay">
                            <p class="carousel-label"></p>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </section>
    </div>

    <div id="artworkModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" data-close-modal>✕</button>
            <div class="modal-body">
                <img id="modalImage" src="" alt="Artwork" class="modal-image">
                <div class="modal-info">
                    <h3 id="modalTitle" class="modal-title"></h3>
                    <p id="modalArtist" class="modal-artist"></p>
                    <p id="modalDescription" class="modal-description"></p>
                    <button class="btn-showroom" data-go-showroom>View in Showroom</button>
                </div>
            </div>
        </div>
        <div class="modal-backdrop" data-close-modal></div>
    </main>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section footer-logo">
                <div class="logo-footer">
                    <span class="art">ART</span><span class="elio">élio</span>
                </div>
                <p class="footer-description">Human-curated art, made to be experienced. Discover masterpieces that speak to your soul.</p>
            </div>

            <div class="footer-section">
                <h4><a href="/about">About Us</a></h4>
                <ul>
                    <li><a href="/about#story">Our Story</a></li>
                    <li><a href="/about#mission">Our Mission</a></li>
                    <li><a href="/about#vision">Our Vision</a></li>

                </ul>
            </div>

            <div class="footer-section">
                <h4><a href="/help">Help</a></h4>
                <ul>
                    <li><a href="/help#faq">FAQ</a></li>
                    <li><a href="/help#privacy">Privacy Policy</a></li>
                    <li><a href="/help#terms">Terms and Conditions</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Get in Touch With Us</h4>
                <div class="newsletter-form">
                    <input type="email" placeholder="Enter your email address" class="email-input">
                    <button class="subscribe-btn">Subscribe</button>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 ARTélio. All rights reserved.</p>
        </div>
    </footer>

    <script id="artworks-data" type="application/json"><%- JSON.stringify(artworks) %></script>
    <script src="/js/main.js"></script>
</body>
</html>
