<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Search Results</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&family=Ibarra+Real+Nova:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Luxurious+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/explore.css">
    <link rel="stylesheet" href="/css/search-results.css">
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">ARTélio</a>
            <nav class="nav-links">
                <a href="/showrooms.html">Showrooms</a>
                <a href="/curators.html">Curators</a>
                <a href="/artists.html">Artists</a>
                <a href="/explore.html">Explore</a>
            </nav>
            <div class="header-icons">
                <button class="icon-btn" title="Search" data-nav="/search">
                    <i class="bi bi-search"></i>
                </button>
                <button class="icon-btn" title="Cart" data-nav="/cart-out">
                    <i class="bi bi-bag-heart"></i>
                </button>
                <% if (currentUser) { %>
                <button class="icon-btn" title="Profile" data-nav="/dashboard"><i class="bi bi-person"></i></button>
                <% } else { %>
                <a href="/login" class="btn-join">Join Now</a>
                <% } %>
            </div>
        </div>
    </header>

    <%
      const total = artworks.length + showrooms.length + artists.length + curators.length;
      const priceRangeOptions = [
        { value: "any", label: "Any price" },
        { value: "under500", label: "Under €500" },
        { value: "500to2000", label: "€500 – €2000" },
        { value: "over2000", label: "Over €2000" },
      ];
      const availabilityOptions = [
        { value: "any", label: "Any status" },
        { value: "available", label: "Available" },
        { value: "sold", label: "Sold" },
      ];
    %>

    <section class="search-results-hero">
        <form method="GET" action="/search-results" class="search-results-bar">
            <div class="search-input-wrapper">
                <i class="bi bi-search"></i>
                <input type="text" name="q" value="<%= term %>" placeholder="Search for art, artist, or curator...">
            </div>
            <input type="hidden" name="filter" value="<%= filters.tag %>">
            <input type="hidden" name="medium" value="<%= filters.medium %>">
            <input type="hidden" name="priceRange" value="<%= filters.priceRange %>">
            <input type="hidden" name="availability" value="<%= filters.availability %>">
            <input type="hidden" name="moodTag" value="<%= filters.moodTag %>">
            <button type="submit" class="search-submit-btn">Search</button>
        </form>
    </section>

    <div class="search-layout">
        <aside class="filter-sidebar" id="filterSidebar">
            <form method="GET" action="/search-results" id="filterForm">
                <input type="hidden" name="q" value="<%= term %>">

                <div class="filter-sidebar-header">
                    <h3><i class="bi bi-sliders"></i> Filters</h3>
                    <a href="<%= clearAllUrl %>" class="clear-filters-link">Clear all</a>
                </div>

                <div class="filter-group">
                    <h4 class="filter-group-title"><i class="bi bi-image"></i> Artworks</h4>

                    <label class="filter-label" for="filterTag">Style Tag</label>
                    <select name="filter" id="filterTag" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="all" <%= filters.tag === "all" ? "selected" : "" %>>All styles</option>
                        <% options.styleTagOptions.forEach(function(t) { %>
                        <option value="<%= t %>" <%= filters.tag === t ? "selected" : "" %>><%= t %></option>
                        <% }); %>
                    </select>

                    <label class="filter-label" for="filterMedium">Technique</label>
                    <select name="medium" id="filterMedium" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="all" <%= filters.medium === "all" ? "selected" : "" %>>Any technique</option>
                        <% options.mediumOptions.forEach(function(m) { %>
                        <option value="<%= m %>" <%= filters.medium === m ? "selected" : "" %>><%= m %></option>
                        <% }); %>
                    </select>

                    <label class="filter-label" for="filterPrice">Price Range</label>
                    <select name="priceRange" id="filterPrice" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                        <% priceRangeOptions.forEach(function(opt) { %>
                        <option value="<%= opt.value %>" <%= filters.priceRange === opt.value ? "selected" : "" %>><%= opt.label %></option>
                        <% }); %>
                    </select>

                    <label class="filter-label" for="filterAvailability">Availability</label>
                    <select name="availability" id="filterAvailability" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                        <% availabilityOptions.forEach(function(opt) { %>
                        <option value="<%= opt.value %>" <%= filters.availability === opt.value ? "selected" : "" %>><%= opt.label %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="filter-group">
                    <h4 class="filter-group-title"><i class="bi bi-columns-gap"></i> Showrooms</h4>

                    <label class="filter-label" for="filterMood">Mood Tag</label>
                    <select name="moodTag" id="filterMood" class="filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="all" <%= filters.moodTag === "all" ? "selected" : "" %>>Any mood</option>
                        <% options.moodTagOptions.forEach(function(t) { %>
                        <option value="<%= t %>" <%= filters.moodTag === t ? "selected" : "" %>><%= t %></option>
                        <% }); %>
                    </select>
                </div>

                <noscript><button type="submit" class="filter-apply-btn">Apply Filters</button></noscript>
            </form>
        </aside>

        <main class="search-results-main">
            <div class="results-toolbar">
                <p class="search-results-recap">
                    <%= total %> result<%= total === 1 ? "" : "s" %><% if (term) { %> for "<%= term %>"<% } %>
                </p>
                <button type="button" class="mobile-filter-toggle" id="mobileFilterToggle">
                    <i class="bi bi-sliders"></i> Filters
                </button>
            </div>

            <% if (activeChips.length > 0) { %>
            <div class="active-filters">
                <% activeChips.forEach(function(chip) { %>
                <a href="<%= chip.url %>" class="filter-chip"><%= chip.label %> <i class="bi bi-x-lg"></i></a>
                <% }); %>
            </div>
            <% } %>

            <% if (total === 0) { %>
            <div class="no-results">
                <i class="bi bi-emoji-frown no-results-icon"></i>
                <p>No matches. Try a different keyword or adjust your filters.</p>
            </div>
            <% } %>

            <% if (artworks.length > 0) { %>
            <section class="result-section">
                <div class="section-header">
                    <h2 class="section-title">ARTWORKS <span class="result-count"><%= artworks.length %></span></h2>
                </div>
                <div class="cards-grid artworks-grid">
                    <% artworks.forEach(function(artwork) { %>
                    <a href="/artwork-details?id=<%= artwork.id %>" class="artwork-card">
                        <div class="artwork-image">
                            <img src="<%= artwork.image_url %>" alt="Artwork">
                            <span class="artwork-status-badge status-<%= artwork.status %>"><%= artwork.status === "sold" ? "Sold" : "Available" %></span>
                        </div>
                        <h3 class="artwork-title"><%= artwork.title %></h3>
                        <p class="artwork-artist"><%= artwork.artist_name %><% if (artwork.medium) { %> · <%= artwork.medium %><% } %></p>
                        <div class="artwork-meta">
                            <span class="artwork-price">€<%= Number(artwork.price).toFixed(2) %></span>
                            <span class="artwork-likes">
                                <i class="bi bi-heart-fill"></i> <%= artwork.save_count %>
                            </span>
                        </div>
                    </a>
                    <% }); %>
                </div>
            </section>
            <% } %>

            <% if (showrooms.length > 0) { %>
            <section class="result-section">
                <div class="section-header">
                    <h2 class="section-title">SHOWROOMS <span class="result-count"><%= showrooms.length %></span></h2>
                </div>
                <div class="cards-grid showrooms-grid">
                    <% showrooms.forEach(function(room) { %>
                    <a href="/single-showroom?room=<%= room.id %>" class="showroom-card">
                        <div class="showroom-cover">
                            <img src="<%= room.cover_image_url %>" alt="Showroom cover">
                        </div>
                        <h3 class="showroom-title"><%= room.title %></h3>
                        <p class="showroom-curator">Curated by <%= room.curator_name %></p>
                    </a>
                    <% }); %>
                </div>
            </section>
            <% } %>

            <% if (artists.length > 0) { %>
            <section class="result-section">
                <div class="section-header">
                    <h2 class="section-title">ARTISTS <span class="result-count"><%= artists.length %></span></h2>
                </div>
                <div class="artists-grid">
                    <% artists.forEach(function(artist) { %>
                    <div class="artist-card">
                        <div class="artist-header">
                            <div class="artist-avatar">
                                <% if (artist.avatar_url) { %>
                                <img src="<%= artist.avatar_url %>" alt="<%= artist.username %>">
                                <% } else { %>
                                <i class="bi bi-person-circle"></i>
                                <% } %>
                            </div>
                        </div>
                        <h3 class="artist-name"><%= artist.username %></h3>
                        <p class="artist-specialty"><%= artist.bio || "Artist on ARTélio" %></p>
                        <a href="/profiles?user=<%= artist.id %>" class="view-profile-btn">View Profile</a>
                    </div>
                    <% }); %>
                </div>
            </section>
            <% } %>

            <% if (curators.length > 0) { %>
            <section class="result-section">
                <div class="section-header">
                    <h2 class="section-title">CURATORS <span class="result-count"><%= curators.length %></span></h2>
                </div>
                <div class="artists-grid">
                    <% curators.forEach(function(curator) { %>
                    <div class="artist-card">
                        <div class="artist-header">
                            <div class="artist-avatar">
                                <% if (curator.avatar_url) { %>
                                <img src="<%= curator.avatar_url %>" alt="<%= curator.username %>">
                                <% } else { %>
                                <i class="bi bi-person-circle"></i>
                                <% } %>
                            </div>
                        </div>
                        <h3 class="artist-name"><%= curator.username %></h3>
                        <p class="artist-specialty"><%= curator.bio || "Curator on ARTélio" %></p>
                        <a href="/profiles?user=<%= curator.id %>" class="view-profile-btn">View Profile</a>
                    </div>
                    <% }); %>
                </div>
            </section>
            <% } %>
        </main>
    </div>

    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section footer-logo">
                <div class="logo-footer">
                    <span class="art">ART</span><span class="elio">élio</span>
                </div>
                <p class="footer-description">Human-curated art, made to be experienced. Discover masterpieces that speak to your soul.</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 ARTélio. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
    <script>
        const sidebar = document.getElementById('filterSidebar');
        const toggle = document.getElementById('mobileFilterToggle');
        if (toggle) {
            toggle.addEventListener('click', () => sidebar.classList.toggle('open'));
        }
    </script>
</body>
</html>
