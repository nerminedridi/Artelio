<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Edit Artwork</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&family=Ibarra+Real+Nova:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Luxurious+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/upload-artwork.css">
</head>
<body>
    <header class="header">
        <h1 class="logo" data-nav="/dashboard-artist">ARTélio</h1>
        <div class="header-icons">
            <button class="icon-btn" title="Cart" data-nav="/cart-in"><i class="bi bi-bag-heart"></i></button>
            <button class="icon-btn" title="Profile" data-nav="/my-profile"><i class="bi bi-person"></i></button>
        </div>
    </header>
    <main class="page-wrapper">
        <h1 class="page-title">Edit Artwork</h1>
        <% if (error) { %>
        <p class="form-error visible"><%= error %></p>
        <% } %>
        <form method="POST" action="/artwork/<%= artwork.id %>/edit" enctype="multipart/form-data">
        <div class="form-card">
            <h2 class="card-title">Artwork Details</h2>

            <div class="form-grid">
                <div class="form-left">
                    <div class="form-group">
                        <label class="form-label">Title:</label>
                        <input type="text" class="form-input" name="title" value="<%= artwork.title %>" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Tags (comma-separated):</label>
                        <input type="text" class="form-input" name="tags" value="<%= (artwork.style_tags || []).join(', ') %>">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Medium/Technique:</label>
                        <input type="text" class="form-input" name="medium" value="<%= artwork.medium || '' %>" placeholder="e.g. Oil on canvas, Bronze sculpture, Marble">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Dimensions:</label>
                        <input type="text" class="form-input" name="dimensions" value="<%= artwork.dimensions || '' %>" placeholder="e.g. 60x80 cm, or 45x30x25 cm (H x W x D) for sculptures">
                    </div>

                    <div class="form-group price-group">
                        <label class="form-label">Price (€):</label>
                        <input type="number" class="form-input price-input" name="price" value="<%= artwork.price %>" min="0" step="0.01" required>
                    </div>
                </div>
                <div class="form-right">
                    <div class="form-group">
                        <label class="form-label">Description:</label>
                        <textarea class="form-textarea" name="description"><%= artwork.description || '' %></textarea>
                    </div>
                    <div class="upload-box" id="uploadBox">
                        <input type="file" id="imageInput" name="image" accept="image/*" class="hidden">
                        <img id="imagePreview" src="<%= artwork.image_url %>" alt="" class="image-preview visible">
                        <span class="upload-placeholder hidden" id="uploadPlaceholder">Upload image</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="action-buttons">
            <button class="btn-submit" type="submit">Save Changes</button>
        </div>
        </form>

        <form method="POST" action="/artwork/<%= artwork.id %>/delete" data-confirm="Delete this artwork? This can't be undone.">
            <button class="btn-preview danger" type="submit">Delete Artwork</button>
        </form>
    </main>
    <footer class="footer">
        <p>© 2026 ARTélio. All rights reserved.</p>
    </footer>

    <script src="/js/main.js"></script>
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                document.getElementById('imagePreview').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        document.getElementById('uploadBox').addEventListener('click', () => {
            document.getElementById('imageInput').click();
        });
        document.getElementById('imageInput').addEventListener('change', previewImage);
    </script>
</body>
</html>
