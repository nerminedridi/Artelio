<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Orders</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/orders.css">
</head>
<body>
    <header class="header">
        <h1 class="logo" data-nav="/dashboard">ARTélio</h1>
        <button class="close-btn" data-nav="/dashboard">
            <i class="bi bi-x-lg"></i> Close
        </button>
    </header>

    <main class="orders-wrapper">
        <h1 class="orders-title">
            <% if (viewType === "artist") { %>Your Sales
            <% } else if (viewType === "curator") { %>Commission History
            <% } else { %>Your Orders
            <% } %>
        </h1>

        <% if (orders.length === 0) { %>
        <p class="no-orders">
            <% if (viewType === "artist") { %>No sales yet.
            <% } else if (viewType === "curator") { %>No commission earned yet.
            <% } else { %>You haven't purchased anything yet.
            <% } %>
        </p>
        <% } else { %>
        <div class="table-wrapper">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Artwork</th>
                        <th>Sale Price</th>
                        <% if (viewType === "artist") { %>
                        <th>Your Earnings</th>
                        <% } else if (viewType === "curator") { %>
                        <th>Your Commission</th>
                        <% } %>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(function(order) { %>
                    <tr>
                        <td>
                            <a href="/artwork-details?id=<%= order.artwork_id %>" class="order-artwork-link">
                                <% if (order.image_url) { %><img src="<%= order.image_url %>" alt="" class="order-thumb"><% } %>
                                <%= order.title %>
                            </a>
                        </td>
                        <td>€<%= Number(order.gross_price).toFixed(2) %></td>
                        <% if (viewType === "artist") { %>
                        <td>€<%= Number(order.artist_net).toFixed(2) %></td>
                        <% } else if (viewType === "curator") { %>
                        <td>€<%= Number(order.commission_amount).toFixed(2) %></td>
                        <% } %>
                        <td><%= new Date(order.purchased_at).toLocaleDateString() %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>

        <% if (viewType === "artist") { %>
        <h1 class="orders-title">Your Purchases</h1>
        <% if (purchases.length === 0) { %>
        <p class="no-orders">You haven't purchased anything yet.</p>
        <% } else { %>
        <div class="table-wrapper">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Artwork</th>
                        <th>Price Paid</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% purchases.forEach(function(order) { %>
                    <tr>
                        <td>
                            <a href="/artwork-details?id=<%= order.artwork_id %>" class="order-artwork-link">
                                <% if (order.image_url) { %><img src="<%= order.image_url %>" alt="" class="order-thumb"><% } %>
                                <%= order.title %>
                            </a>
                        </td>
                        <td>€<%= Number(order.gross_price).toFixed(2) %></td>
                        <td><%= new Date(order.purchased_at).toLocaleDateString() %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>
        <% } %>
    </main>

    <footer class="footer">
        <p>© 2026 ARTélio. All rights reserved.</p>
    </footer>
    <script src="/js/main.js"></script>
</body>
</html>
