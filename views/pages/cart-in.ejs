<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ARTélio — Cart</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Cormorant+Garamond:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/cart-in.css" />
</head>
<body>

  <header class="site-header">
    <a href="/" class="logo">ARTélio</a>
    <a href="/home" class="close-btn">
      <span>× Close</span>
      <svg class="cart-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
    </a>
  </header>

  <main class="main-content">
    <h1 class="cart-title"><em>Cart</em></h1>

    <div class="cart-layout">

      <section class="cart-table-section">
        <div class="table-header">
          <span class="col-product">Product</span>
          <span class="col-price">Price</span>
          <span class="col-delete">Delete</span>
        </div>
        <hr class="table-divider"/>

        <% if (items.length === 0) { %>
        <p class="empty-cart-message">Your cart is empty. <a href="/explore">Explore artworks</a> to add some.</p>
        <% } %>
        <% items.forEach(function(item) { %>
        <div class="cart-row" data-artwork-id="<%= item.id %>">
          <div class="product-info">
            <img src="<%= item.image_url %>" alt="<%= item.title %>" class="artwork-thumb"/>
            <span class="product-name"><%= item.title %></span>
          </div>
          <span class="product-price">€<%= Number(item.price).toFixed(2) %></span>
          <button class="delete-btn" aria-label="Remove item" data-remove-id="<%= item.id %>">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
              <path d="M10 11v6"/><path d="M14 11v6"/>
              <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
            </svg>
          </button>
        </div>
        <% }); %>
      </section>

      <aside class="summary-panel">
        <h2 class="summary-title">Summary</h2>
        <hr class="summary-divider"/>

        <div class="summary-row total-row">
          <span class="summary-label">Total</span>
          <span class="summary-value total-value">€<%= subtotal.toFixed(2) %></span>
        </div>

        <button class="checkout-btn" <%= items.length === 0 ? "disabled" : "" %> data-nav="/checkout">Proceed to checkout</button>
      </aside>

    </div>
  </main>

  <footer class="site-footer">
    <p>© 2026 ARTélio. All rights reserved.</p>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    document.querySelectorAll('[data-remove-id]').forEach(function (btn) {
      btn.addEventListener('click', async function () {
        const id = btn.getAttribute('data-remove-id');
        await fetch('/cart/remove/' + id, { method: 'POST' });
        window.location.reload();
      });
    });
  </script>
</body>
</html>
