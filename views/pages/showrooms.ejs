<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Showrooms</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&family=Ibarra+Real+Nova:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Luxurious+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/showrooms.css">
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">ARTélio</a>
            <nav class="nav-links">
                <a href="/showrooms.html">Showrooms</a>
                <a href="/curators.html">Curators</a>
                <a href="/artists.html">Artists</a>
                <a href="/explore.html">Explore</a>
            </nav>
            <div class="header-icons">
                <button class="icon-btn" title="Search" data-nav="/search">
                    <i class="bi bi-search"></i>
                </button>
                <button class="icon-btn" title="Cart" data-nav="/cart-out">
                    <i class="bi bi-bag-heart"></i>
                </button>
                <% if (currentUser) { %>
                <button class="icon-btn" title="Profile" data-nav="/dashboard"><i class="bi bi-person"></i></button>
                <% } else { %>
                <a href="/login" class="btn-join">Join Now</a>
                <% } %>
            </div>
        </div>
    </header>
    <main>
    <% if (featured) { %>
    <section class="hero">
        <div class="hero-image-wrapper">
            <img src="<%= featured.cover_image_url %>" alt="Featured Showroom" class="hero-bg">
            <div class="hero-overlay"></div>
        </div>
        <div class="hero-content">
            <span class="hero-label">✦ Newest Showroom</span>
            <h1 class="hero-title"><%= featured.title %></h1>
            <p class="hero-curator">Curated by <strong><%= featured.curator_name %></strong></p>
            <p class="hero-description">
                <%= featured.concept_essay %>
            </p>
            <div class="hero-meta">
                <span><i class="bi bi-images"></i> <%= featured.artwork_count %> Artworks</span>
                <span><i class="bi bi-star-fill"></i> <%= Number(featured.avg_artwork_rating).toFixed(1) %> avg. rating</span>
            </div>
            <a href="/single-showroom?room=<%= featured.id %>" class="hero-btn">Visit Showroom <i class="bi bi-arrow-right"></i></a>
        </div>
    </section>
    <% } %>
    <div class="page-body">

        <section class="section-block">
            <div class="section-top">
                <h2 class="section-title">All Showrooms</h2>
            </div>
            <div class="showrooms-grid three-col">
                <% if (showrooms.length === 0) { %>
                <p class="no-showrooms">No showrooms yet.</p>
                <% } %>
                <% showrooms.forEach(function(room) { %>
                <div class="showroom-card">
                    <div class="card-cover">
                        <img src="<%= room.cover_image_url %>" alt="Showroom">
                        <div class="card-overlay"></div>
                    </div>
                    <div class="card-body">
                        <h3 class="card-title"><%= room.title %></h3>
                        <p class="card-curator">Curated by <span><%= room.curator_name %></span></p>
                        <p class="card-theme"><%= room.concept_essay %></p>
                        <div class="card-footer">
                            <span class="card-count"><i class="bi bi-images"></i> <%= room.artwork_count %> Artworks</span>
                            <a href="/single-showroom?room=<%= room.id %>" class="card-arrow"><i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>

    </div>
    </div>
    </main>
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-section footer-logo">
                <div class="logo-footer">
                    <span class="art">ART</span><span class="elio">élio</span>
                </div>
                <p class="footer-description">Human-curated art, made to be experienced. Discover masterpieces that speak to your soul.</p>
            </div>

            <div class="footer-section">
                <h4><a href="/about.html">About Us</a></h4>
                <ul>
                    <li><a href="/about.html#story">Our Story</a></li>
                    <li><a href="/about.html#mission">Our Mission</a></li>
                    <li><a href="/about.html#vision">Our Vision</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h4><a href="/help.html">Help</a></h4>
                <ul>
                    <li><a href="/help.html#faq">FAQ</a></li>
                    <li><a href="/help.html#privacy">Privacy Policy</a></li>
                    <li><a href="/help.html#terms">Terms and Conditions</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h4>Get in Touch With Us</h4>
                <div class="newsletter-form">
                    <input type="email" placeholder="Enter your email address" class="email-input">
                    <button class="subscribe-btn">Subscribe</button>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 ARTélio. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
