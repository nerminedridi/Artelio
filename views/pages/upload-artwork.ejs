<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Upload Artwork</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&family=Ibarra+Real+Nova:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Luxurious+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/upload-artwork.css">
</head>
<body>
    <header class="header">
        <h1 class="logo" data-nav="/dashboard-artist">ARTélio</h1>
        <div class="header-icons">
            <button class="icon-btn" title="Notifications"><i class="bi bi-bell"></i></button>
            <button class="icon-btn" title="Cart" data-nav="/cart-in"><i class="bi bi-bag-heart"></i></button>
            <button class="icon-btn" title="Profile" data-nav="/dashboard"><i class="bi bi-person"></i></button>
        </div>
    </header>
    <main class="page-wrapper">
        <h1 class="page-title">Upload an Artwork to a Showroom</h1>
        <% if (error) { %>
        <p class="form-error visible"><%= error %></p>
        <% } %>
        <form method="POST" action="/upload-artwork" enctype="multipart/form-data">
        <div class="form-card">
            <h2 class="card-title">1-Artwork Details</h2>

            <div class="form-grid">
                <div class="form-left">
                    <div class="form-group">
                        <label class="form-label">Title:</label>
                        <input type="text" class="form-input" id="artworkTitle" name="title" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Tags (comma-separated):</label>
                        <input type="text" class="form-input" id="artworkTags" name="tags" placeholder="abstract, ethereal">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Medium/Technique:</label>
                        <input type="text" class="form-input" id="artworkMedium" name="medium" placeholder="e.g. Oil on canvas, Bronze sculpture, Marble">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Dimensions:</label>
                        <input type="text" class="form-input" id="artworkDimensions" name="dimensions" placeholder="e.g. 60x80 cm, or 45x30x25 cm (H x W x D) for sculptures">
                    </div>

                    <div class="form-group price-group">
                        <label class="form-label">Price (€):</label>
                        <input type="number" class="form-input price-input" id="artworkPrice" name="price" min="0" step="0.01" required>
                    </div>
                </div>
                <div class="form-right">
                    <div class="form-group">
                        <label class="form-label">Description:</label>
                        <textarea class="form-textarea" id="artworkDescription" name="description"></textarea>
                    </div>
                    <div class="upload-box" id="uploadBox">
                        <input type="file" id="imageInput" name="image" accept="image/*" class="hidden" required>
                        <img id="imagePreview" src="" alt="" class="image-preview">
                        <span class="upload-placeholder" id="uploadPlaceholder">Upload image</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-card">
            <h2 class="card-title">2-Select Showroom</h2>

            <div class="showroom-grid">
                <% showrooms.forEach(function(room) { %>
                <div class="showroom-card" id="showroom-<%= room.id %>" data-room-id="<%= room.id %>">
                    <div class="showroom-info">
                        <p class="showroom-name"><%= room.title %></p>
                        <p>Theme: <%= room.theme %></p>
                        <p>Curated by: <%= room.curator_name %></p>
                        <p><%= room.artwork_count %> artworks currently featured</p>
                    </div>
                    <button class="select-btn" type="button">Select</button>
                </div>
                <% }); %>
                <% if (showrooms.length === 0) { %>
                <p class="no-showrooms">No active showrooms to submit to yet.</p>
                <% } %>
            </div>
            <input type="hidden" name="showroomId" id="showroomIdInput">
        </div>
        <div class="action-buttons">
            <button class="btn-preview" type="button" id="previewBtn">Preview Artwork</button>
            <button class="btn-submit" type="submit">Submit to Showroom</button>
        </div>
        </form>

    </main>
    <footer class="footer">
        <p>© 2026 ARTélio. All rights reserved.</p>
    </footer>

    <script src="/js/main.js"></script>
    <script>
      (function () {
        let selectedShowroom = null;

        function previewImage(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                const preview = document.getElementById('imagePreview');
                const placeholder = document.getElementById('uploadPlaceholder');
                preview.src = e.target.result;
                preview.classList.add('visible');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }
        function selectShowroom(card, id) {
            document.querySelectorAll('.showroom-card').forEach(c => {
                c.classList.remove('selected');
                const btn = c.querySelector('.select-btn');
                if (btn) btn.textContent = 'Select';
            });
            card.classList.add('selected');
            const btn = card.querySelector('.select-btn');
            if (btn) btn.textContent = 'Selected ✓';
            selectedShowroom = id;
            document.getElementById('showroomIdInput').value = id;
        }
        function previewArtwork() {
            const title = document.getElementById('artworkTitle').value;
            if (!title.trim()) {
                alert('Please fill in the artwork title first.');
                return;
            }
            alert('Preview coming soon!');
        }

        document.getElementById('uploadBox').addEventListener('click', () => {
            document.getElementById('imageInput').click();
        });
        document.getElementById('imageInput').addEventListener('change', previewImage);
        document.querySelectorAll('.showroom-card').forEach((card) => {
            card.addEventListener('click', () => selectShowroom(card, card.dataset.roomId));
        });
        document.getElementById('previewBtn').addEventListener('click', previewArtwork);
      })();
    </script>
</body>
</html>
