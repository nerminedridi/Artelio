<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARTélio - Edit Showroom</title>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@800&family=EB+Garamond:wght@400;500;600;700&family=Gelasio:wght@400;500;600;700&family=Ibarra+Real+Nova:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=Luxurious+Script&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/upload-artwork.css">
</head>
<body>
    <header class="header">
        <h1 class="logo" data-nav="/dashboard-curator">ARTélio</h1>
        <div class="header-icons">
            <button class="icon-btn" title="Cart" data-nav="/cart-in"><i class="bi bi-bag-heart"></i></button>
            <button class="icon-btn" title="Profile" data-nav="/my-profile"><i class="bi bi-person"></i></button>
        </div>
    </header>
    <main class="page-wrapper">
        <h1 class="page-title">Edit Showroom</h1>
        <% if (error) { %>
        <p class="form-error visible"><%= error %></p>
        <% } %>
        <form method="POST" action="/curator/showrooms/<%= showroom.id %>/edit" enctype="multipart/form-data">
        <div class="form-card">
            <h2 class="card-title">Showroom Details</h2>

            <div class="form-grid">
                <div class="form-left">
                    <div class="form-group">
                        <label class="form-label">Title:</label>
                        <input type="text" class="form-input" name="title" value="<%= showroom.title %>" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Theme:</label>
                        <input type="text" class="form-input" name="theme" value="<%= showroom.theme || '' %>">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Mood Tags (comma-separated):</label>
                        <input type="text" class="form-input" name="moodTags" value="<%= (showroom.mood_tags || []).join(', ') %>" placeholder="dreamlike, calm, bold">
                    </div>

                    <div class="form-group price-group">
                        <label class="form-label">Commission Rate (%):</label>
                        <input type="number" class="form-input price-input" name="commissionRate" value="<%= showroom.commission_rate %>" min="0" max="100" step="0.01">
                    </div>
                </div>
                <div class="form-right">
                    <div class="form-group">
                        <label class="form-label">Concept Essay:</label>
                        <textarea class="form-textarea" name="conceptEssay"><%= showroom.concept_essay || '' %></textarea>
                    </div>
                    <div class="upload-box" id="uploadBox">
                        <input type="file" id="imageInput" name="coverImage" accept="image/*" class="hidden">
                        <% if (showroom.cover_image_url) { %>
                        <img id="imagePreview" src="<%= showroom.cover_image_url %>" alt="" class="image-preview visible">
                        <span class="upload-placeholder hidden" id="uploadPlaceholder">Cover image</span>
                        <% } else { %>
                        <img id="imagePreview" src="" alt="" class="image-preview">
                        <span class="upload-placeholder" id="uploadPlaceholder">Upload cover image</span>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
        <div class="action-buttons">
            <button class="btn-submit" type="submit">Save Changes</button>
        </div>
        </form>

        <div class="form-card">
            <h2 class="card-title">Artwork Order</h2>
            <% if (artworks.length === 0) { %>
            <p class="no-showrooms">No approved artworks in this showroom yet.</p>
            <% } %>
            <div class="reorder-list">
                <% artworks.forEach(function(art, i) { %>
                <div class="reorder-item">
                    <img src="<%= art.image_url %>" alt="<%= art.title %>" class="reorder-thumb">
                    <span class="reorder-title"><%= art.title %></span>
                    <div class="reorder-actions">
                        <form method="POST" action="/curator/submissions/<%= art.submission_id %>/reorder" class="inline-form">
                            <input type="hidden" name="direction" value="up">
                            <input type="hidden" name="roomId" value="<%= showroom.id %>">
                            <button type="submit" class="reorder-btn" <%= i === 0 ? "disabled" : "" %>><i class="bi bi-arrow-up"></i></button>
                        </form>
                        <form method="POST" action="/curator/submissions/<%= art.submission_id %>/reorder" class="inline-form">
                            <input type="hidden" name="direction" value="down">
                            <input type="hidden" name="roomId" value="<%= showroom.id %>">
                            <button type="submit" class="reorder-btn" <%= i === artworks.length - 1 ? "disabled" : "" %>><i class="bi bi-arrow-down"></i></button>
                        </form>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>

        <form method="POST" action="/curator/showrooms/<%= showroom.id %>/delete" data-confirm="Delete this showroom? This can't be undone.">
            <button class="btn-preview danger" type="submit">Delete Showroom</button>
        </form>
    </main>
    <footer class="footer">
        <p>© 2026 ARTélio. All rights reserved.</p>
    </footer>

    <script src="/js/main.js"></script>
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (e) => {
                const preview = document.getElementById('imagePreview');
                const placeholder = document.getElementById('uploadPlaceholder');
                preview.src = e.target.result;
                preview.classList.add('visible');
                placeholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }

        document.getElementById('uploadBox').addEventListener('click', () => {
            document.getElementById('imageInput').click();
        });
        document.getElementById('imageInput').addEventListener('change', previewImage);
    </script>
</body>
</html>
